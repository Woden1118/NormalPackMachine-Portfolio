<Window x:Class="WpfSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
        Title="NormalPack Studio | WPF Simulator"
        Icon="/WpfSimulator;component/Assets/NormalPack.ico"
        Height="600" Width="950" MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#101827" Foreground="#F3F6FB"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8EEF6"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Image Source="/WpfSimulator;component/Assets/NormalPack.ico"
                   Width="50" Height="50" VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <StackPanel Grid.Column="1">
                <TextBlock Text="NORMALPACK • WPF SHOWCASE" Foreground="#93C5FD" FontSize="12" FontWeight="Bold"/>
                <TextBlock Text="工业视觉检测 · 独立模拟器" FontSize="27" FontWeight="SemiBold" Margin="0,8,0,6"/>
                <TextBlock Text="模拟数据 / 不连接真实 PLC、相机或 MES" Foreground="#9AA9C0" FontSize="13"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Background="#192439" CornerRadius="10" Padding="16" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="运行状态：" FontSize="15" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusText}" FontSize="15" FontWeight="Bold"
                           Foreground="#93C5FD" VerticalAlignment="Center" Margin="0,0,32,0"/>
                <Button Content="启动模拟" Command="{Binding StartCommand}"/>
                <Button Content="停止模拟" Command="{Binding StopCommand}" Background="#475569"/>
            </StackPanel>
        </Border>
        <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,18">
            <Border Background="#192439" CornerRadius="10" Padding="20" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="检测总数" FontSize="13" Foreground="#A7B5CA"/>
                    <TextBlock Text="{Binding TotalCount}" FontSize="36" FontWeight="Bold" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#192439" CornerRadius="10" Padding="20" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="OK 数量" FontSize="13" Foreground="#A7B5CA"/>
                    <TextBlock Text="{Binding OkCount}" FontSize="36" FontWeight="Bold" Foreground="#4ADE80" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#192439" CornerRadius="10" Padding="20">
                <StackPanel>
                    <TextBlock Text="NG 数量" FontSize="13" Foreground="#A7B5CA"/>
                    <TextBlock Text="{Binding NgCount}" FontSize="36" FontWeight="Bold" Foreground="#FB7185" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>
        <Border Grid.Row="3" Background="#192439" CornerRadius="10" Padding="16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="运行日志（合成数据）" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <ListBox ItemsSource="{Binding LogEntries}" Background="#131F32" Foreground="#CBD5E1"
                         BorderThickness="0" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"/>
            </DockPanel>
        </Border>
        <TextBlock Grid.Row="4" Text="PORTFOLIO DEMO  |  NOT FOR INDUSTRIAL PRODUCTION"
                   Foreground="#8BA0BD" FontSize="11" Margin="0,16,0,0" HorizontalAlignment="Right"/>
    </Grid>
</Window>
