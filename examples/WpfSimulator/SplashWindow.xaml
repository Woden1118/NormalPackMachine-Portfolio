<Window x:Class="WpfSimulator.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NormalPack Studio" Height="360" Width="650"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Icon="/WpfSimulator;component/Assets/NormalPack.ico"
        Background="#F8FAFC" FontFamily="Microsoft YaHei UI, Segoe UI">
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#0D2A51">
            <StackPanel VerticalAlignment="Center" Margin="28">
                <Image Source="/WpfSimulator;component/Assets/NormalPack.ico" Width="108" Height="108" HorizontalAlignment="Left" Margin="0,0,0,22"/>
                <TextBlock Text="NormalPack" Foreground="White" FontSize="26" FontWeight="Bold"/>
                <TextBlock Text="STUDIO" Foreground="#72B4FF" FontSize="16" FontWeight="SemiBold" Margin="0,5,0,16"/>
                <TextBlock Text="工业视觉 WPF 作品集" Foreground="#C5D8F1" FontSize="12"/>
            </StackPanel>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="30">
            <TextBlock Text="欢迎使用 NormalPack Studio" FontSize="21" Foreground="#213954" FontWeight="SemiBold"/>
            <TextBlock Text="正在准备独立模拟演示…" FontSize="13" Foreground="#627993" Margin="0,16,0,28"/>
            <ProgressBar Height="5" IsIndeterminate="True" Foreground="#2B83EA" Background="#DDE7F5" BorderThickness="0"/>
            <TextBlock Text="模拟数据 · 不连接真实硬件" FontSize="12" Foreground="#6D839B" Margin="0,25,0,0"/>
        </StackPanel>
    </Grid>
</Window>
